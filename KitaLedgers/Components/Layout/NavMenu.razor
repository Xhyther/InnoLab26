
@using Microsoft.AspNetCore.Components.Routing
@using MudBlazor

<MudNavMenu Bordered="true"
            Margin="Margin.Dense"
            Color="Color.Primary"
            Class="pa-0 d-flex flex-column"
            Style="height:100%; overflow-x:hidden;">

    <MudTooltip Text="Overview"
                Placement="Placement.Right"
                Arrow="true"
                Disabled="@DrawerOpen"
                RootClass="d-block"
                RootStyle="width:100%;">
        <MudNavLink Href="/overview"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.GridView">
            Overview
        </MudNavLink>
    </MudTooltip>

    <MudTooltip Text="Lea AI Adviser"
                Placement="Placement.Right"
                Arrow="true"
                Disabled="@DrawerOpen"
                RootClass="d-block"
                RootStyle="width:100%;">
        <MudNavLink Href="/adviser"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.EnergySavingsLeaf">
            Lea AI Adviser
        </MudNavLink>
    </MudTooltip>

    <MudTooltip Text="Transactions"
                Placement="Placement.Right"
                Arrow="true"
                Disabled="@DrawerOpen"
                RootClass="d-block"
                RootStyle="width:100%;">
        <MudNavLink Href="/transactions"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.Receipt">
            Transactions
        </MudNavLink>
    </MudTooltip>

    <MudTooltip Text="Inventory"
                Placement="Placement.Right"
                Arrow="true"
                Disabled="@DrawerOpen"
                RootClass="d-block"
                RootStyle="width:100%;">
        <MudNavLink Href="/inventory"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.Inventory">
            Inventory
        </MudNavLink>
    </MudTooltip>

    <MudTooltip Text="Financial Passport"
                Placement="Placement.Right"
                Arrow="true"
                Disabled="@DrawerOpen"
                RootClass="d-block"
                RootStyle="width:100%;">
        <MudNavLink Href="/passport"
                    Match="NavLinkMatch.Prefix"
                    Icon="@Icons.Material.Outlined.AssignmentInd">
            Financial Passport
        </MudNavLink>
    </MudTooltip>

    <div class="mt-auto">
        <MudTooltip Text="Settings"
                    Placement="Placement.Right"
                    Arrow="true"
                    Disabled="@DrawerOpen"
                    RootClass="d-block"
                    RootStyle="width:100%;">
            <MudNavLink Href="/settings"
                        Match="NavLinkMatch.Prefix"
                        Icon="@Icons.Material.Rounded.Settings">
                Settings
            </MudNavLink>
        </MudTooltip>
    </div>
</MudNavMenu>

@code {
    [Parameter]
    public bool DrawerOpen { get; set; }
}
