
@using MudBlazor
@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme"
                 @bind-IsDarkMode="_isDarkMode" />

<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1"
               Dense="false"
               Gutters="false"
               Style="backdrop-filter: blur(10px);">

        <MudContainer MaxWidth="MaxWidth.ExtraLarge"
                      Class="d-flex align-center px-4">

            <button type="button"
                    @onclick="DrawerToggle"
                    class="svg-menu-btn"
                    aria-label="@(_drawerOpen ? "Collapse navigation" : "Expand navigation")"
                    aria-controls="nav-drawer"
                    aria-expanded="@_drawerOpen">

                <MudImage Src="LOGO-Leaf.svg"
                          Alt="PaLEAsta logo"
                          Width="32"
                          Height="32"
                          ObjectFit="ObjectFit.Contain" />
            </button>

            <MudImage Src="PaLEAsta!.svg"
                      Alt="PaLEAsta!"
                      Width="120"
                      Height="40"
                      ObjectFit="ObjectFit.Contain"
                      Class="ms-2" />

            <MudSpacer />

            <MudIconButton Icon="@DarkLightModeButtonIcon"
                           Color="Color.Inherit"
                           OnClick="DarkModeToggle"
                           AriaLabel="Toggle dark mode" />

            <MudIconButton Icon="@Icons.Material.Rounded.Info"
                           Color="Color.Inherit"
                           Edge="Edge.End"
                           Href="https://github.com/Zanpakuto/Hazelnet_Web/wiki"
                           Target="_blank"
                           AriaLabel="Help and documentation" />
        </MudContainer>
    </MudAppBar>

    <MudDrawer @bind-Open="_drawerOpen"
               id="nav-drawer"
               Variant="DrawerVariant.Mini"
               Breakpoint="Breakpoint.None"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Width="260px"
               MiniVariantWidth="64px">

        <NavMenu DrawerOpen="@_drawerOpen" />
    </MudDrawer>

    <MudMainContent Class="main-content">
        <div class="main-content-inner">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <button type="button" class="dismiss" aria-label="Dismiss error">
        🗙
    </button>
</div>

<style>
    .svg-menu-btn {
        background: transparent;
        border: none;
        padding: 8px;
        border-radius: 50%;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        transition: background-color 250ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .svg-menu-btn:hover {
        background-color: rgba(var(--mud-palette-primary-rgb), 0.08);
    }

    .svg-menu-btn:focus-visible {
        outline: 2px solid var(--mud-palette-primary);
        outline-offset: 2px;
    }

    .main-content {
        padding-top: 64px;
        min-height: 100vh;
        background: var(--mud-palette-background);
    }

    .main-content-inner {
        padding: 24px;
        min-width: 0;
    }

    #blazor-error-ui {
        display: none;
        position: fixed;
        inset: auto 0 0 0;
        z-index: 2000;
        padding: 0.75rem 1.25rem;
        background: #fff4ce;
        color: #332b00;
    }

    #blazor-error-ui .dismiss {
        float: right;
        border: 0;
        background: transparent;
        cursor: pointer;
    }

    @@media (max-width: 600px) {
        .main-content-inner {
            padding: 16px;
        }
    }
</style>

