@page "/Adviser"
@attribute [Authorize]
@layout MainPageLayout

@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using KitaLedgers.Data

@inject IAdvisorService Advisor
@inject AuthenticationStateProvider AuthState

<PageTitle>Ask LEA</PageTitle>

<div class="chat">

    @* ───────── Header ───────── *@
    <header class="chat-head">
        <div class="chat-id">
            <img src="lea-mascot.svg" alt="" class="chat-avatar" />
            <div>
                <div class="chat-name">LEA</div>
                <div class="chat-role">AI financial adviser · uses your recorded transactions</div>
            </div>
        </div>
        @if (_turns.Count > 0)
        {
            <button type="button" class="chat-new" @onclick="NewChat" disabled="@_busy">
                <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round" fill="none" /></svg>
                New chat
            </button>
        }
    </header>

    @* ───────── Thread (column-reverse keeps it pinned to the newest message, no JS) ───────── *@
    <div class="chat-scroll">
        <div class="chat-inner @(_turns.Count == 0 && !_busy ? "chat-inner--empty" : "")">
            @if (_turns.Count == 0 && !_busy)
            {
                <div class="chat-empty">
                    <img src="lea-mascot.svg" alt="" class="chat-empty-avatar" />
                    <h1 class="chat-empty-title">What are you planning for your business?</h1>
                    <p class="chat-empty-sub">Ask about restocking, cash flow, expenses, or loans. LEA only uses the numbers you've recorded.</p>
                    <div class="chat-suggest">
                        @foreach (var s in _suggestions)
                        {
                            <button type="button" class="chat-chip" @onclick="() => SendText(s)">@s</button>
                        }
                    </div>
                </div>
            }
            else
            {
                @foreach (var t in _turns)
                {
                    if (t.FromUser)
                    {
                        <div class="msg msg--me">
                            <div class="bubble">@t.Text</div>
                        </div>
                    }
                    else
                    {
                        <div class="msg msg--lea">
                            <img src="lea-mascot.svg" alt="LEA" class="msg-avatar" />
                            <div class="msg-body">@t.Text</div>
                        </div>
                    }
                }

                @if (_busy)
                {
                    <div class="msg msg--lea">
                        <img src="lea-mascot.svg" alt="LEA" class="msg-avatar" />
                        <div class="typing" aria-label="LEA is thinking"><span></span><span></span><span></span></div>
                    </div>
                }
            }
        </div>
    </div>

    @* ───────── Composer ───────── *@
    <form class="composer" @onsubmit="SendInput">
        <div class="composer-box">
            <input class="composer-input"
                   @bind="_input" @bind:event="oninput"
                   placeholder="Message LEA…"
                   autocomplete="off"
                   disabled="@_busy" />
            <button type="submit" class="composer-send" aria-label="Send"
                    disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                    <path d="M12 19V5M5 12l7-7 7 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" fill="none" />
                </svg>
            </button>
        </div>
        <p class="composer-note">LEA can make mistakes and isn't a licensed financial adviser. Summarized business figures are sent to Google Gemini.</p>
    </form>
</div>

@code {
    [SupplyParameterFromQuery(Name = "q")] public string? Q { get; set; }

    private readonly List<ChatTurn> _turns = new();
    private string? _input;
    private bool _busy;
    private string? _userId;

    private readonly string[] _suggestions =
    {
        "Can I afford a ₱10,000 restock this week?",
        "How is my cash flow trending?",
        "Where is most of my money going?",
        "Am I ready to apply for a bank loan?",
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirstValue(ClaimTypes.NameIdentifier);
    }

    // Runs only once the page is interactive, so prerendering doesn't fire a second API call.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(Q))
            await SendText(Q);
    }

    private Task SendInput() => SendText(_input);

    private async Task SendText(string? text)
    {
        var q = text?.Trim();
        if (string.IsNullOrEmpty(q) || _busy || _userId is null) return;

        var history = _turns.ToList();
        _turns.Add(new ChatTurn(true, q));
        _input = string.Empty;
        _busy = true;
        StateHasChanged();

        try
        {
            var answer = await Advisor.AskAsync(_userId, q, history);
            _turns.Add(new ChatTurn(false, answer));
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private void NewChat()
    {
        _turns.Clear();
        _input = string.Empty;
    }
}
